# Cloudflare Workers static assets: https://developers.cloudflare.com/workers/static-assets/headers/
# Rules match the request path, and a header set by two matching rules is joined, so keep them apart.

# Named by content hash, but a missing file is answered with a page, and that answer would be
# kept too: a day, not a year.
/assets/*
  Cache-Control: public, max-age=86400

# Same name when they change: checked again after a day. HTML and the manifest keep the default.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-16x16.png
  Cache-Control: public, max-age=86400
/favicon-32x32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192x192.png
  Cache-Control: public, max-age=86400
/icon-512x512.png
  Cache-Control: public, max-age=86400
/tinkjam-mark.svg
  Cache-Control: public, max-age=86400
/tinkjam-wordmark.svg
  Cache-Control: public, max-age=86400
