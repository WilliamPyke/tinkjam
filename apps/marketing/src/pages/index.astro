---
import Layout from "../layouts/Layout.astro";
import { APP_URL, SAMPLE_BOARD_URL } from "../lib/site";

// The only place these four names appear regardless of what a person has installed.
const agents = [
  { name: "Claude", icon: "/agents/claude-icon.svg", mono: false },
  { name: "Codex", icon: "/agents/openai-icon.svg", mono: true },
  { name: "Grok", icon: "/agents/grok-icon.svg", mono: true },
  { name: "Cursor", icon: "/agents/cursor-icon.svg", mono: true },
];
const faces = [
  { initial: "P", color: "var(--forest)" },
  { initial: "S", color: "var(--raspberry)" },
  { initial: "M", color: "var(--claude)" },
  { initial: "+4", color: "var(--sun)", ink: "#17141C" },
];
const arrow = "M2 2l5.5 13 2-5.5 5.5-2z";
---

<Layout navOver>
  <section class="hero">
    <div class="hero__stage">
      <h1 class="headline" data-headline>
        <span class="sr-only">build beautiful things with your AI agent and your teammates</span>
        <span aria-hidden="true">
          <span class="headline__line">build beautiful</span>
          <span class="headline__line"
            >things with
            <span class="agent-box" data-agent-box>
              <span class="agent-stack">
                {
                  agents.map((agent, index) => (
                    <span class:list={["agent", { "is-on": index === 0 }]} data-agent>
                      <img
                        class:list={{ "mono-icon": agent.mono }}
                        src={agent.icon}
                        width="100"
                        height="100"
                        alt=""
                      />
                      {agent.name}
                    </span>
                  ))
                }
              </span>
              <i class="handle handle--tl"></i><i class="handle handle--tr"></i><i
                class="handle handle--bl"></i><i class="handle handle--br"></i>
              <span class="cursor">
                <svg viewBox="0 0 18 18"
                  ><path d={arrow} fill="var(--accent)" stroke="var(--page)" stroke-width="1.2"
                  ></path></svg
                >
                <span style="background:var(--btn)">You</span>
              </span>
            </span>
          </span>
          <span class="headline__line"
            >and
            <span class="mates" data-mates>
              <span class="faces is-on">
                {
                  faces.map((face) => (
                    <span class="face" style={`background:${face.color};color:${face.ink ?? "#fff"}`}>
                      <span>{face.initial}</span>
                    </span>
                  ))
                }
              </span>
              <span>your teammates</span>
            </span>
          </span>
        </span>
      </h1>

      <div class="board" data-board>
        <svg
          class="board__lines"
          aria-hidden="true"
          width="1440"
          height="900"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M1150 598v100q0 14-14 14H984" data-line-out></path><path d="M992 705l-8 7 8 7"
          ></path>
          <path d="M1280 790V602" data-line-figma></path><path d="M1273 610l7-8 7 8"></path>
          <g class="board__link"><path data-link></path><path data-link-head></path></g>
        </svg>

        <div class="bcard note" aria-hidden="true">
          Bigger photos on the landing page, and lose the carousel.
          <div class="note__by">Priya</div>
        </div>
        <div class="cursor drift cursor--priya" aria-hidden="true">
          <svg viewBox="0 0 18 18"
            ><path d={arrow} fill="var(--forest)" stroke="var(--page)" stroke-width="1.2"></path></svg
          >
          <span style="background:var(--forest)">Priya</span>
        </div>
        <button class="linker" type="button" data-linker>
          <span class="linker__dot" data-linker-dot></span>
          <span class="linker__label">
            <span class="linker__drag">Draw a line to Codex</span>
            <span class="linker__tap">Connect Priya's note to Codex</span>
          </span>
        </button>

        <div class="bcard codex" aria-hidden="true" data-codex data-state="ready">
          <div class="bcard__head">
            <img class="mono-icon" src="/agents/openai-icon.svg" width="16" height="16" alt="" />Codex<span
              class="bcard__sub">Sam's agent</span
            ><span class="chip chip--status" data-status>Ready</span>
          </div>
          <div class="codex__body">
            <div class="codex__chips">
              <span class="chip chip--quiet codex__note">1 note</span><span class="chip chip--quiet"
                >1 link</span
              >
            </div>
            <div class="codex__ask">
              <span>Update the landing page to match</span><span class="codex__send" data-send>Send</span>
            </div>
            <p class="codex__says" data-says></p>
          </div>
        </div>
        <div class="bcard figma" aria-hidden="true">
          <div class="bcard__head">
            <img src="/agents/figma.svg" width="11" height="16" alt="" />Spring photos
          </div>
        </div>
        <div class="cursor drift cursor--maya" aria-hidden="true">
          <svg viewBox="0 0 18 18"
            ><path d={arrow} fill="var(--claude)" stroke="var(--page)" stroke-width="1.2"></path></svg
          >
          <span style="background:var(--claude)">Maya</span>
        </div>

        <div class="bcard landing" aria-hidden="true" data-landing>
          <div class="bcard__head">
            Landing page<span class="chip chip--live" data-live>Live</span>
          </div>
          <div class="landing__body">
            <div class="site site--before">
              <div class="site__nav"><i class="site__logo"></i><i></i><i></i><i></i></div>
              <div class="site__photo">
                <svg class="site__scene" viewBox="0 0 100 50" preserveAspectRatio="xMidYMax meet"><circle cx="74" cy="14" r="7"></circle><path d="M0 50L30 20l16 15 12-9 26 24z"></path></svg><span class="site__arrow">&lsaquo;</span><span class="site__arrow">&rsaquo;</span>
              </div>
              <div class="site__dots"><i></i><i></i><i></i></div>
              <div class="site__title">Spring collection</div>
              <div class="site__tiles">
                <span><i></i></span><span><i></i></span><span><i></i></span>
              </div>
            </div>
            <div class="site site--loading">
              <div class="site__nav"><i class="site__logo"></i><i></i><i></i><i></i></div>
              <div class="site__photo site__photo--big"></div>
              <i class="site__bar site__bar--title"></i>
              <i class="site__bar"></i><i class="site__bar site__bar--short"></i>
              <i class="site__bar site__bar--button"></i>
            </div>
            <div class="site site--after">
              <div class="site__nav"><i class="site__logo"></i><i></i><i></i><i></i></div>
              <div class="site__photo site__photo--big"><svg class="site__scene" viewBox="0 0 100 50" preserveAspectRatio="xMidYMax meet"><circle cx="74" cy="14" r="7"></circle><path d="M0 50L30 20l16 15 12-9 26 24z"></path></svg></div>
              <div class="site__title">Spring collection</div>
              <i class="site__bar"></i><i class="site__bar site__bar--short"></i>
              <span class="site__button">Shop now</span>
            </div>
          </div>
        </div>
        <div class="bcard comment" aria-hidden="true">
          <span class="comment__face">M</span>Much better. Can we try it in blue?
        </div>
        <div class="cursor drift cursor--sam" aria-hidden="true" data-sam>
          <svg viewBox="0 0 18 18"
            ><path d={arrow} fill="var(--raspberry)" stroke="var(--page)" stroke-width="1.2"
            ></path></svg
          >
          <span style="background:var(--raspberry)">Sam</span>
        </div>
        <button class="replay" type="button" data-replay hidden>Draw it again</button>
        <p class="sr-only" aria-live="polite" data-announce></p>
      </div>

      <div class="intro">
        <p class="intro__lede">
          Tinkjam is a shared board for your team. Everyone brings their own AI agent, and everyone
          sees what it makes.
        </p>
        <div class="intro__ctas">
          <a class="btn btn--lg" href={APP_URL}>Start a board</a>
          {
            SAMPLE_BOARD_URL === "" ? null : (
              <a class="navlink intro__sample" href={SAMPLE_BOARD_URL}>
                See a sample board
              </a>
            )
          }
        </div>
        <p class="intro__fine">Free while in beta. No account needed.</p>
      </div>
    </div>
  </section>

  <section class="panels">
    <div class="panel panel--blue">
      <div aria-hidden="true">
        <div class="cursor drift cursor--a">
          <svg viewBox="0 0 18 18"
            ><path d={arrow} fill="var(--sun)" stroke="#2F5BEA" stroke-width="1"></path></svg
          >
          <span style="background:var(--sun)">Priya</span>
        </div>
        <div class="cursor drift cursor--b">
          <svg viewBox="0 0 18 18"
            ><path d={arrow} fill="#FFFFFF" stroke="#2F5BEA" stroke-width="1"></path></svg
          >
          <span style="background:#FFFFFF">Sam</span>
        </div>
        <div class="cursor drift cursor--c">
          <svg viewBox="0 0 18 18"
            ><path d={arrow} fill="var(--claude)" stroke="#2F5BEA" stroke-width="1"></path></svg
          >
          <span style="background:var(--claude)">Maya's Claude</span>
        </div>
      </div>
      <h2>a shared workspace for modern teams</h2>
      <p>
        Notes, links, pages and prototypes in one place. You see your teammates and their agents
        work as it happens.
      </p>
    </div>
    <div class="panel">
      <div class="tiles" aria-hidden="true">
        {
          agents.map((agent) => (
            <span class="tile">
              <img
                class:list={{ "mono-icon": agent.mono }}
                src={agent.icon}
                width="48"
                height="48"
                alt=""
              />
            </span>
          ))
        }
      </div>
      <h2>bring your own agent</h2>
      <p>
        Connect Claude, Codex, Grok or Cursor from your own computer, on your own account. Nothing
        goes to it until you send it.
      </p>
    </div>
  </section>
</Layout>

<script>
  // The headline's agent is dragged off toward the board and the next one is brought in from above.
  const headline = document.querySelector<HTMLElement>("[data-headline]");
  const box = headline?.querySelector<HTMLElement>("[data-agent-box]");
  const mates = headline?.querySelector<HTMLElement>("[data-mates]");
  // The box is dragged toward Codex, so it waits while the board below is playing.
  const board = document.querySelector<HTMLElement>("[data-board]");
  if (headline && box && mates && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const agents = [...box.querySelectorAll<HTMLElement>("[data-agent]")];
    const mateStates = [...mates.children] as HTMLElement[];
    let agent = 0;
    let mate = 0;
    setInterval(() => {
      if (board?.dataset.demo === "linked") return;
      box.classList.add("is-leaving");
      setTimeout(() => {
        agents[agent]?.classList.remove("is-on");
        agent = (agent + 1) % agents.length;
        agents[agent]?.classList.add("is-on");
        box.classList.replace("is-leaving", "is-arriving");
        void box.offsetWidth;
        box.classList.remove("is-arriving");
      }, 650);
    }, 6500);
    setInterval(() => {
      mates.classList.add("is-fading");
      setTimeout(() => {
        mateStates[mate]?.classList.remove("is-on");
        mate = (mate + 1) % mateStates.length;
        mateStates[mate]?.classList.add("is-on");
        mates.classList.remove("is-fading");
      }, 250);
    }, 5200);
  }
</script>

<script>
  import { startHeroDemo } from "../lib/heroDemo";

  const board = document.querySelector<HTMLElement>("[data-board]");
  if (board) startHeroDemo(board);
</script>
