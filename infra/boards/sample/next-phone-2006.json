    {
      "id": "sample-elena-themes-1",
      "by": "elena",
      "box": "elena-agent",
      "model": "Claude Sonnet 5.5",
      "prompt": "Pull the field notes into three or four themes, with the quote that shows each one best.",
      "context": ["f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8"],
      "reply": "Four themes in the artifact beside me: people carry too many gadgets, the phone web isn't the real web, photos are stuck on the phone, and thumb typing matters more than we thought. Each has the quote that shows it best.",
      "artifact": {
        "card": "themes",
        "body": "next-phone-2006/themes.md"
      }
    },
    {
      "id": "sample-marcus-fit-1",
      "by": "marcus",
      "box": "marcus-agent",
      "model": "GPT-5.5",
      "prompt": "For each idea, estimate the parts cost, the battery hit and the months to ship on next year's phone. Flag the ones that don't fit.",
      "context": ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "razr", "nano", "bb"],
      "reply": "Scored all eight ideas in the table. Three fit next year's phone: the browser, the music player and photo sharing. GPS costs too much battery for now, and a two-day battery doesn't fit beside a bigger screen.",
      "artifact": {
        "card": "fit",
        "body": "next-phone-2006/fit.md"
      }
    },
    {
      "id": "sample-hana-pick-1",
      "by": "hana",
      "box": "hana-agent",
      "model": "Claude Opus 5.5",
      "prompt": "Using Elena's themes and Marcus's table, pick the one feature to build first and write a one-page concept for it.",
      "context": ["themes", "fit"],
      "reply": "Picked the pocket web: it answers the strongest theme in Elena's research and fits Marcus's cost and battery numbers. The one-pager is on the right, with what we'd build, what we'd leave out and how we'd test it.",
      "artifact": {
        "card": "brief",
        "body": "next-phone-2006/brief.html"
      }
    }
