    {
      "id": "field",
      "by": "elena",
      "section": true,
      "text": "Field notes, March 2006",
      "x": 0,
      "y": 0,
      "size": {
        "w": 952,
        "h": 400
      },
      "color": "blue"
    },
    {
      "id": "f1",
      "by": "elena",
      "text": "Commuters type email with both thumbs on the train. Keyboard phones win there.",
      "x": 24,
      "y": 64,
      "color": "blue"
    },
    {
      "id": "f2",
      "by": "elena",
      "text": "6 of the 10 people we met carry a phone and an iPod. Two carry a camera as well.",
      "x": 256,
      "y": 64,
      "color": "blue"
    },
    {
      "id": "f3",
      "by": "hana",
      "text": "Camera-phone photos never leave the phone. \"How would I even send them?\"",
      "x": 488,
      "y": 64,
      "color": "pink"
    },
    {
      "id": "f4",
      "by": "marcus",
      "text": "People print driving directions before they leave home.",
      "x": 720,
      "y": 64,
      "color": "green"
    },
    {
      "id": "f5",
      "by": "elena",
      "text": "The web on a phone is WAP pages. \"It's not the real internet.\"",
      "x": 24,
      "y": 232,
      "color": "blue"
    },
    {
      "id": "f6",
      "by": "hana",
      "text": "After calls, texting is what people use most. T9 is put up with, not loved.",
      "x": 256,
      "y": 232,
      "color": "pink"
    },
    {
      "id": "f7",
      "by": "marcus",
      "text": "Anyone who browses on their phone is out of battery by 6pm.",
      "x": 488,
      "y": 232,
      "color": "green"
    },
    {
      "id": "f8",
      "by": "elena",
      "text": "BlackBerry owners won't switch. Push email is the reason they carry one.",
      "x": 720,
      "y": 232,
      "color": "blue"
    },
    {
      "id": "pockets",
      "by": "marcus",
      "section": true,
      "text": "What's in their pockets",
      "x": 0,
      "y": 440,
      "size": {
        "w": 952,
        "h": 288
      },
      "color": "grey"
    },
    {
      "id": "razr",
      "by": "marcus",
      "text": "Motorola RAZR V3: the phone everyone we met wanted",
      "x": 24,
      "y": 504,
      "kind": "link",
      "url": "https://en.wikipedia.org/wiki/Motorola_Razr_V3",
      "size": {
        "w": 264,
        "h": 200
      }
    },
    {
      "id": "nano",
      "by": "hana",
      "text": "iPod nano: what music on the go looks like now",
      "x": 312,
      "y": 504,
      "kind": "link",
      "url": "https://en.wikipedia.org/wiki/IPod_Nano",
      "size": {
        "w": 264,
        "h": 200
      }
    },
    {
      "id": "bb",
      "by": "elena",
      "text": "BlackBerry: why email people won't switch",
      "x": 600,
      "y": 504,
      "kind": "link",
      "url": "https://en.wikipedia.org/wiki/BlackBerry",
      "size": {
        "w": 264,
        "h": 200
      }
    },
    {
      "id": "ideas",
      "by": "hana",
      "section": true,
      "text": "Ideas",
      "x": 0,
      "y": 768,
      "size": {
        "w": 952,
        "h": 400
      },
      "color": "yellow"
    },
    {
      "id": "i1",
      "by": "hana",
      "text": "A real web browser: whole pages, zoomed to fit the screen",
      "x": 24,
      "y": 832,
      "color": "pink"
    },
    {
      "id": "i2",
      "by": "marcus",
      "text": "A music player built in, as easy to use as an iPod",
      "x": 256,
      "y": 832,
      "color": "green"
    },
    {
      "id": "i3",
      "by": "marcus",
      "text": "GPS and maps on the phone. No more printed directions.",
      "x": 488,
      "y": 832,
      "color": "green"
    },
    {
      "id": "i4",
      "by": "hana",
      "text": "Send a photo to the web in two clicks",
      "x": 720,
      "y": 832,
      "color": "pink"
    },
    {
      "id": "i5",
      "by": "elena",
      "text": "Push email for everyone, not only BlackBerry owners",
      "x": 24,
      "y": 1000
    },
    {
      "id": "i6",
      "by": "marcus",
      "text": "A keyboard on the screen that goes away when you don't need it",
      "x": 256,
      "y": 1000,
      "color": "green"
    },
    {
      "id": "i7",
      "by": "hana",
      "text": "Let other companies write programs for the phone",
      "x": 488,
      "y": 1000,
      "color": "pink"
    },
    {
      "id": "i8",
      "by": "marcus",
      "text": "A battery that lasts two days of browsing",
      "x": 720,
      "y": 1000,
      "color": "green"
    },
